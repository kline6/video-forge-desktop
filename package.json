{
  "name": "video-forge-desktop",
  "version": "1.0.0",
  "description": "Pluggable AI Digital Avatar Video Generator",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "edge-tts": "^1.0.0",
    "form-data": "^4.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "p-queue": "^8.0.0",
    "uuid": "^10.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "zustand": "^5.0.0",
    "@types/sql.js": "^1.4.5"
  },
  "build": {
    "appId": "com.videoforge.desktop",
    "productName": "VideoForge Desktop",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
